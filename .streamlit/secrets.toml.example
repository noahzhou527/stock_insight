# Optional: reserved for the official iFinD data channel.
# Public A-share valuation and intraday data do not require this token.
# Copy this file to .streamlit/secrets.toml and replace the value.
THS_ACCESS_TOKEN = "your-iFinD-access-token"

# Optional: fetch the currently valid access token automatically.
# THS_REFRESH_TOKEN = "your-iFinD-refresh-token"

# Official codes supplied by iFinD can override unresolved overseas symbols.
# [IFIND_CODES]
# "005930.KS" = "official-iFinD-code"
